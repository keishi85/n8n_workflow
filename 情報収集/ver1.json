    {
      "parameters": {
        "jsCode": "// 翻訳が必要な記事のみ抽出\nconst allArticles = $input.all();\nconst needsTranslation = allArticles.filter(item => item.json.needsTranslation === true);\n\nconsole.log(`翻訳対象記事: ${needsTranslation.length}件`);\n\nif (needsTranslation.length === 0) {\n  console.log(\"翻訳が必要な記事はありません\");\n  return [];\n}\n\nreturn needsTranslation;"
      },
