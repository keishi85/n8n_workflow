    {
      "parameters": {
        "jsCode": "// RSS記事データを統一フォーマットに整形\nconst sourceInfo = $(\"Loop Over Items\").first().json;\n\nreturn items.map(item => ({\n  title: item.json.title,\n  description: item.json.description || item.json.summary || item.json.contentSnippet,\n  link: item.json.link,\n  pubDate: item.json.pubDate || item.json.isoDate,\n  category: sourceInfo.category,\n  source_name: sourceInfo.source_name,\n  priority: sourceInfo.priority,\n  collected_at: new Date().toISOString(),\n  processed: false,\n  guid: item.json.guid || item.json.link  // 重複判定用\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
