    {
      "parameters": {
        "jsCode": "// 入力データから記事情報を取得\nconst articles = $input.all();\n\n// ヘッダーブロック\nconst blocks = [\n  {\n    \"type\": \"header\",\n    \"text\": {\n      \"type\": \"plain_text\",\n      \"text\": `📰 AI・N8N情報収集結果 (${articles.length}件)`,\n      \"emoji\": true\n    }\n  },\n  {\n    \"type\": \"context\",\n    \"elements\": [\n      {\n        \"type\": \"mrkdwn\",\n        \"text\": `収集日時: ${new Date().toLocaleString('ja-JP')}`\n      }\n    ]\n  },\n  {\n    \"type\": \"divider\"\n  }\n];\n\n// 各記事のセクションブロックを生成\narticles.forEach((article, index) => {\n  // 記事セクション\n  blocks.push({\n    \"type\": \"section\",\n    \"text\": {\n      \"type\": \"mrkdwn\",\n      \"text\": `*${index + 1}. ${article.json.元記事タイトル}*\\n\\n${article.json.記事内容.substring(0, 300)}...`\n    },\n    \"accessory\": {\n      \"type\": \"button\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"記事を読む\",\n        \"emoji\": true\n      },\n      \"url\": article.json.元記事URL,\n      \"action_id\": `read_article_${index}`\n    }\n  });\n\n  // メタデータ\n  blocks.push({\n    \"type\": \"context\",\n    \"elements\": [\n      {\n        \"type\": \"mrkdwn\",\n        \"text\": `📅 ${article.json.日付} | 🏷️ ${article.json.カテゴリ || 'AI関連'} | 🔄 ${article.json.備考}`\n      }\n    ]\n  });\n\n  // 記事間の区切り（最後の記事以外）\n  if (index < articles.length - 1) {\n    blocks.push({\n      \"type\": \"divider\"\n    });\n  }\n});\n\n// フッター\nblocks.push({\n  \"type\": \"context\",\n  \"elements\": [\n    {\n      \"type\": \"mrkdwn\",\n      \"text\": \"🤖 N8N SNS情報収集システム - 自動生成\"\n    }\n  ]\n});\n\nreturn { blocks };"
      },
