      "parameters": {
        "jsCode": "// 1ヶ月以内の記事のみ抽出\n// const oneMonthAgo = new Date();\n// oneMonthAgo.setMonth(oneMonthAgo.getMonth() - 1);\n\n// const recentArticles = items.filter(item => {\n//   const pubDate = new Date(item.json.pubDate || item.json.isoDate);\n//   return pubDate >= oneMonthAgo;\n// });\n\n// console.log(`全記事: ${items.length}, 1ヶ月以内: ${recentArticles.length} (${$input.first().json.source_name})`);\n\n// 1日分フィルタ（コメントアウト）\n// 1日以内の記事のみ抽出\nconst oneDayAgo = new Date();\noneDayAgo.setDate(oneDayAgo.getDate() - 5);\nconst recentArticles = items.filter(item => {\n  const pubDate = new Date(item.json.pubDate || item.json.isoDate);\n  return pubDate >= oneDayAgo;\n});\nconsole.log(`全記事: ${items.length}, 1日以内: ${recentArticles.length} (${$input.first().json.source_name})`);\n\nreturn recentArticles;"
