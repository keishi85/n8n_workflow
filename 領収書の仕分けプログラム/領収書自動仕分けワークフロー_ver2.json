{
  "name": "領収書",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Step2. 画像検証・Base64エンコード（複数アイテム対応の完全版）\nconsole.log('=== 領収書画像処理開始 ===');\n\nconst items = $input.all(); // すべてのファイルを配列として取得\nconst results = [];\n\n// 届いたファイルの数だけループ処理\nfor (let i = 0; i < items.length; i++) {\n  try {\n    const driveInfo = items[i].json;\n    const fileId = driveInfo.id;\n    const fileName = driveInfo.name;\n    const mimeType = driveInfo.mimeType;\n    const parentFolders = driveInfo.parents || [];\n    \n    // 💡超重要：i番目（現在処理中）の画像データを正確に取得\n    const binaryData = await this.helpers.getBinaryDataBuffer(i, 'data');\n\n    if (!binaryData) {\n      throw new Error('画像データが見つかりません。');\n    }\n\n    // 画像形式の検出\n    const detectImageFormat = (buffer) => {\n      const header = buffer.toString('hex', 0, 12);\n      const base64Header = buffer.toString('base64', 0, 20);\n      if (header.startsWith('ffd8ff')) return { format: 'JPEG', supported: true };\n      if (header.startsWith('89504e47')) return { format: 'PNG', supported: true };\n      if (header.includes('667479706865696') || base64Header.includes('NGZ0eXBoZWljAAAA')) return { format: 'HEIC', supported: false };\n      if (header.includes('6674797068656966')) return { format: 'HEIF', supported: false };\n      return { format: 'UNKNOWN', supported: false };\n    }\n\n    const formatInfo = detectImageFormat(binaryData);\n\n    if (!formatInfo.supported) {\n      results.push({\n        json: {\n          error: {\n            code: 'UNSUPPORTED_FORMAT',\n            message: `iPhoneの高画質フォーマット（${formatInfo.format}形式）は現在サポートされていません。`,\n            solution: 'iPhoneの設定を変更するか、LINEなどを経由してJPEGに変換してください。'\n          },\n          googleDriveMetadata: { fileId, fileName, mimeType, parentFolders },\n          status: '❌ 非対応形式検出（iPhoneの設定変更が必要です）'\n        }\n      });\n      continue; // エラーのファイルはスキップして次のファイルへ\n    }\n\n    // ファイルサイズチェック(20MB制限)\n    const maxSize = 20 * 1024 * 1024;\n    if (binaryData.length > maxSize) {\n      throw new Error(`サイズオーバー: ${Math.round(binaryData.length / 1024 / 1024)}MB (上限20MB)`);\n    }\n\n    // Base64エンコード\n    let base64String = binaryData.toString('base64').replace(/[\\r\\n\\s]/g, '');\n\n    // 成功結果を結果リストに追加\n    results.push({\n      json: {\n        googleDriveMetadata: { fileId, fileName, mimeType, parentFolders },\n        imageInfo: { format: formatInfo.format, sizeBytes: binaryData.length },\n        base64Image: base64String,\n        status: '✅ 画像処理完了'\n      }\n    });\n\n  } catch (error) {\n    results.push({\n      json: {\n        error: { message: error.message },\n        googleDriveMetadata: { fileId: items[i].json.id, fileName: items[i].json.name },\n        status: '❌ 画像処理失敗'\n      }\n    });\n  }\n}\n\n// すべての処理結果を次のノードへ一気に渡す\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
